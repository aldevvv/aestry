# =====================================
# Aestry Server Configuration
# =====================================
# Copy to .env.local and fill in what you use. Empty variables are simply
# unconfigured features — the app runs local-first without any of them.

# -------------------------------------
# Application access
# -------------------------------------
# When set, provider operations (chat, generation, model discovery,
# diagnostics, project context) require operator sign-in with this secret.
# The browser only receives a derived session cookie — never this value.
# Leave empty for a local-only deployment without access control.
AESTRY_ACCESS_SECRET=

# -------------------------------------
# Google Gemini Developer API (Milestone C)
# -------------------------------------
GOOGLE_API_KEY=
AESTRY_GEMINI_CHAT_MODEL=
AESTRY_GEMINI_IMAGE_MODEL=

# -------------------------------------
# Google Vertex AI (Milestone C)
# -------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
AESTRY_VERTEX_CHAT_MODEL=
AESTRY_VERTEX_IMAGE_MODEL=

# -------------------------------------
# Database providers (Milestone E)
# -------------------------------------
AESTRY_DATABASE_PROVIDER=

# Supabase
SUPABASE_DATABASE_URL=

# Neon
NEON_DATABASE_URL=

# Generic PostgreSQL
DATABASE_URL=

# -------------------------------------
# Diagnostics
# -------------------------------------
# When true, the Terminal additionally captures truncated raw provider
# excerpts to help debug provider issues. These may contain fragments of
# conversation content — keep disabled on shared deployments.
AESTRY_ENABLE_DIAGNOSTICS=false

# -------------------------------------
# Outbound policy
# -------------------------------------
# Allow provider base URLs pointing at private/loopback addresses (e.g. a
# local LM Studio). Only enable on trusted networks.
AESTRY_ALLOW_PRIVATE_ENDPOINTS=false
